[Unit]
Description=Discord Mental-Health RL Research Brief Bot
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=discord-research-brief
Group=discord-research-brief
WorkingDirectory=/opt/discord-research-brief-bot
EnvironmentFile=/etc/discord-research-brief-bot.env
ExecStart=/opt/discord-research-brief-bot/bin/discord-research-brief-bot
Restart=on-failure
RestartSec=10s
TimeoutStopSec=30s

StateDirectory=discord-research-brief-bot
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
